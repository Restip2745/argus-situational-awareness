# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_CTX=2048

# Logging (debug | info | warn | error | silent — default: info)
# LOG_LEVEL=info

# Config endpoint auth (optional)
# When set, POST /api/config/llm and /api/config/feeds require X-Config-Key header
# CONFIG_SECRET=your_config_secret_here

# SQLite database path (optional — defaults to <repo>/data/intelligence.db)
# The default is resolved from the source tree, not the working directory, so
# the server and the scripts in scripts/ always open the same file.
# Useful for Docker deployments where the DB lives inside a named volume
# DB_PATH=/app/data/intelligence.db

# AIS Ship Tracking (optional)
# Free API key from https://aisstream.io — leave blank to disable the ships layer
# AISSTREAM_API_KEY=your_key_here

# Azure Speech (optional)
# Reads the intel brief aloud when set. Can also be set from the Configuration
# dialog in the UI (saved to server/data/secrets.json, gitignored — never
# server/data/config.json). These env vars are just the self-hosted default.
# AZURE_SPEECH_KEY=your_key_here
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_VOICE=zh-TW-HsiaoChenNeural

# Webhook Event Ingestion (optional)
# Set a secret key to enable POST /api/events/webhook for external event push.
# Send X-Webhook-Key: <your_secret> in the request header.
# WEBHOOK_SECRET=your_secret_here

# Conflict Front Layer (optional)
# Sources are fetched in parallel, cached 24 hours each, and merged into one
# FeatureCollection. Falls back to demo data (approximate Ukraine 2024) if unset.
#
# Either a preset name, or a JSON array of {id, url, control, conflict, label}.
# `control` is stamped onto every feature from that source and drives the map
# colour: "frontline" | "contested" | "russia" | "ukraine" | "israel" | "sdf" |
# "strike". `conflict` groups features by theatre. Geometry may be lines,
# polygons or points.
#
# "isw" = Institute for the Study of War / AEI Critical Threats Project layers
# (Ukraine control + 24h gains, Syria SDF, Iran strikes). Attribution required —
# see https://www.understandingwar.org for their terms.
# CONFLICT_SOURCES=isw
#
# Custom example (single line):
# CONFLICT_SOURCES=[{"id":"ua","url":"https://example.com/fronts.geojson","control":"frontline","conflict":"ukraine"}]
#
# Other ISW layers worth adding, verified live but left out of the preset to keep
# the default payload small. Append the shared query string to each:
#   /FeatureServer/<id>/query?where=1%3D1&outFields=*&outSR=4326&f=geojson&geometryPrecision=4
# under https://services5.arcgis.com/SaBe5HMtmnbqSWlu/arcgis/rest/services/
#   View_AssessedRussianInfiltrationAreasinUkraine_V4        layer 0   (~970 KB)
#   VIEW_Russian_controlled_Ukrainian_Territory_before_February_24_2022  layer 36
#   MDS_CF_Strikes_on_Iran_2026_view                         layer 0   (points)
#
# Legacy single-source form, still honoured when CONFLICT_SOURCES is unset.
# Features are passed through untagged, so they all render in the default colour.
# CONFLICT_GEOJSON_URL=https://example.com/conflict_fronts.geojson
